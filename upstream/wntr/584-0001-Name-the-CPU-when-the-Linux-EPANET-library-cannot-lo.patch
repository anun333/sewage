From d3fc35476b398c9de5d7a507529ab1ba37a81724 Mon Sep 17 00:00:00 2001
From: anun333 <anun333@posteo.net>
Date: Fri, 30 Oct 2026 11:49:03 -0500
Subject: [PATCH] Name the CPU when the Linux EPANET library cannot load

The EPANET libraries included for Linux are x86-64 only, and toolkit.py
loads them on every Linux. On aarch64 the load failed with "cannot open
shared object file", although the file is there (#584). Check
platform.machine() before loading, in ENepanet and MSXepanet, and raise
NotImplementedError naming the CPU and saying that WNTRSimulator still
works. Note the supported CPUs in the installation requirements.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 documentation/installation.rst    |  3 +++
 wntr/epanet/msx/toolkit.py        |  3 ++-
 wntr/epanet/toolkit.py            | 18 ++++++++++++++++++
 wntr/tests/test_epanet_toolkit.py | 18 ++++++++++++++++++
 4 files changed, 41 insertions(+), 1 deletion(-)

diff --git a/documentation/installation.rst b/documentation/installation.rst
index 6fba2260..cc68ebe1 100644
--- a/documentation/installation.rst
+++ b/documentation/installation.rst
@@ -257,6 +257,9 @@ Requirements
 
 Requirements for WNTR include 64-bit Python (tested on versions 3.11, 3.12, and 3.13) along with several Python packages. 
 Users should have experience using Python (https://www.python.org/), including the installation of additional Python packages. 
+The EPANET libraries included with WNTR, which the EpanetSimulator uses, are built for x86-64 on Linux and Windows,
+and for both Intel and Apple silicon on macOS.
+On Linux on other processors (aarch64, for example), the WNTRSimulator can be used but the EpanetSimulator cannot.
 
 **The following Python packages are required**:
 
diff --git a/wntr/epanet/msx/toolkit.py b/wntr/epanet/msx/toolkit.py
index e777c607..91c4537a 100644
--- a/wntr/epanet/msx/toolkit.py
+++ b/wntr/epanet/msx/toolkit.py
@@ -20,7 +20,7 @@ from importlib.resources import files
 
 from wntr.epanet.msx.enums import TkObjectType, TkSourceType
 
-from ..toolkit import ENepanet
+from ..toolkit import ENepanet, _check_linux_machine
 from .exceptions import (MSX_ERROR_CODES, EpanetMsxException, MSXKeyError,
                          MSXValueError)
 
@@ -45,6 +45,7 @@ class MSXepanet(ENepanet):
         self.msxfile = msxfile
 
         try:
+            _check_linux_machine()
             if os.name in ["nt", "dos"]:
                 libepanet = str(files('wntr.epanet').joinpath("libepanet/windows-x64/epanet2.dll"))
                 libmsx = str(files('wntr.epanet').joinpath("libepanet/windows-x64/epanetmsx.dll"))
diff --git a/wntr/epanet/toolkit.py b/wntr/epanet/toolkit.py
index eae6ba90..915a7590 100644
--- a/wntr/epanet/toolkit.py
+++ b/wntr/epanet/toolkit.py
@@ -30,6 +30,23 @@ else:
     libepanet = "libepanet/linux-x64/libepanet22.so"
 
 
+def _check_linux_machine():
+    """Raise an error naming the CPU on Linux if it is not x86-64.
+
+    The EPANET libraries included for Linux are built for x86-64 only. On any
+    other CPU (aarch64, for example) loading them fails with "cannot open
+    shared object file", although the file is there.
+    """
+    if os.name in ["nt", "dos"] or sys.platform in ["darwin"]:
+        return
+    machine = platform.machine()
+    if machine.lower() not in ["x86_64", "amd64"]:
+        raise NotImplementedError(
+            "The EPANET libraries included with WNTR for Linux are built for x86-64, "
+            "and this machine is {}. EpanetSimulator and wntr.epanet.toolkit cannot "
+            "run here; WNTRSimulator can.".format(machine))
+
+
 def ENgetwarning(code, sec=-1):
     if sec >= 0:
         hours = int(sec / 3600.0)
@@ -105,6 +122,7 @@ class ENepanet:
         self.binfile = binfile
 
         try:
+            _check_linux_machine()
             if float(version) == 2.0:
                 libname = libepanet.replace('epanet22.','epanet20.')
                 if 'arm' in platform.platform():
diff --git a/wntr/tests/test_epanet_toolkit.py b/wntr/tests/test_epanet_toolkit.py
index a9ae6438..319873ff 100644
--- a/wntr/tests/test_epanet_toolkit.py
+++ b/wntr/tests/test_epanet_toolkit.py
@@ -1,8 +1,10 @@
 import unittest
+from unittest import mock
 from os.path import join, exists
 import sys, platform
 
 import wntr.epanet.toolkit
+import wntr.epanet.msx.toolkit
 
 if 'darwin' in sys.platform.lower() and 'arm' in platform.platform().lower():
     skip_v2_tests_on_arm = True
@@ -140,5 +142,21 @@ class TestEpanetToolkit(unittest.TestCase):
 
             assert (t == 86400)
 
+
+class TestLinuxMachine(unittest.TestCase):
+
+    @unittest.skipUnless(sys.platform.startswith("linux"), "the check applies to Linux only")
+    def test_non_x86_64_raises(self):
+        # The included Linux libraries are x86-64; on another CPU the error
+        # must name the CPU rather than say the file cannot be opened (#584)
+        with mock.patch("platform.machine", return_value="aarch64"):
+            with self.assertRaisesRegex(NotImplementedError, "aarch64"):
+                wntr.epanet.toolkit.ENepanet()
+            with self.assertRaisesRegex(NotImplementedError, "aarch64"):
+                wntr.epanet.msx.toolkit.MSXepanet()
+        with mock.patch("platform.machine", return_value="x86_64"):
+            wntr.epanet.toolkit._check_linux_machine()
+
+
 if __name__ == "__main__":
     unittest.main()
